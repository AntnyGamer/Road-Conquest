<resources>
    <style name="RoadConquest.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">@drawable/primary_button_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/primary_button_text</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="RoadConquest.SettingsAction" parent="@style/RoadConquest.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">@drawable/settings_action_background</item>
        <item name="android:textColor">@color/secondary_button_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="RoadConquest.NavigationAction" parent="@style/RoadConquest.SettingsAction">
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="RoadConquest.FilterAction" parent="@style/RoadConquest.SettingsAction">
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="RoadConquest.DangerAction" parent="@style/RoadConquest.SettingsAction">
        <item name="android:textColor">@color/danger</item>
    </style>

    <style name="Theme.RoadConquest" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:buttonStyle">@style/RoadConquest.Button</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="android:colorAccent">@color/road_blue</item>
        <item name="rcScreenBg">@color/screen_bg</item>
        <item name="rcPanelBg">@color/panel_bg</item>
        <item name="rcTextPrimary">@color/text_primary</item>
        <item name="rcTextSecondary">@color/text_secondary</item>
        <item name="rcAccent">@color/road_blue</item>
        <item name="rcOutline">@color/outline</item>
        <item name="rcMutedBg">@color/muted_surface</item>
        <item name="rcOnAccent">@color/text_on_accent</item>
    </style>

    <style name="Theme.RoadConquest.Gold" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:buttonStyle">@style/RoadConquest.Button</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/gold_screen_bg</item>
        <item name="android:colorAccent">@color/gold_accent</item>
        <item name="rcScreenBg">@color/gold_screen_bg</item>
        <item name="rcPanelBg">@color/gold_panel_bg</item>
        <item name="rcTextPrimary">@color/gold_text_primary</item>
        <item name="rcTextSecondary">@color/gold_text_secondary</item>
        <item name="rcAccent">@color/gold_accent</item>
        <item name="rcOutline">@color/gold_outline</item>
        <item name="rcMutedBg">@color/gold_muted_surface</item>
        <item name="rcOnAccent">@color/gold_on_accent</item>
    </style>
</resources>