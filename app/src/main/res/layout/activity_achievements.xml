<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/achievementsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <Button
            android:id="@+id/backNavButton"
            style="@style/RoadConquest.BackAction"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:text="@string/tour_back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_your_milestones"
            android:letterSpacing="0.14"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/rcAccent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ui_achievements"
            android:accessibilityHeading="true"
            android:textColor="?attr/rcTextPrimary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ui_earn_badges_and_bonus_points_from_roads_map_tiles_mileage_places"
            android:textColor="?attr/rcTextSecondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/achievementPointsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel_background"
            android:text="@string/ui_0_points"
            android:textColor="?attr/rcTextPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/achievementCategoryButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button style="@style/RoadConquest.FilterAction" android:id="@+id/achievementRoadsButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" />
                <Button style="@style/RoadConquest.FilterAction" android:id="@+id/achievementTilesButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/ui_map_tiles" />
                <Button style="@style/RoadConquest.FilterAction" android:id="@+id/achievementDistanceButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/ui_mileage" />
                <Button style="@style/RoadConquest.FilterAction" android:id="@+id/achievementPlacesButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/ui_exploration" />
                <Button style="@style/RoadConquest.FilterAction" android:id="@+id/achievementTownsButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/ui_town_badges" />
                <Button style="@style/RoadConquest.FilterAction" android:id="@+id/achievementAdsButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/ui_ad_rewards" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/achievementsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingBottom="20dp"
            android:text="@string/ui_loading_achievements"
            android:textColor="?attr/rcTextPrimary"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/achievementsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:paddingBottom="8dp" />
    </LinearLayout>
    </ScrollView>
    <include layout="@layout/ad_banner" />
</LinearLayout>
