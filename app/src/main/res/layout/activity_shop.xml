<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shopRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <Button
            android:id="@+id/backNavButton"
            style="@style/RoadConquest.BackAction"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:text="← Back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CUSTOMIZE YOUR JOURNEY"
            android:letterSpacing="0.14"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/rcAccent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Garage &amp; Shop"
            android:accessibilityHeading="true"
            android:textColor="?attr/rcTextPrimary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shopPointsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel_background"
            android:elevation="3dp"
            android:text="⚔ 0 points"
            android:textColor="?attr/rcTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shopProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?attr/rcTextSecondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/shopRewardButton"
            style="@style/RoadConquest.SettingsAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="@string/ad_unavailable" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ad_reward_explanation"
            android:textColor="?attr/rcTextSecondary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/shopItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:paddingBottom="12dp" />

    </LinearLayout>
    </ScrollView>

    <include layout="@layout/ad_banner" />
</LinearLayout>
