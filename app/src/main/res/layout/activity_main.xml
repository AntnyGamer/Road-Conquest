<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:maplibre="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Keep the live map and fog on MapLibre's render surface. -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        maplibre:maplibre_cameraZoomMax="20.0"
        maplibre:maplibre_renderTextureMode="true" />

    <!-- On first launch after an install/update, avoid exposing partially loaded
         low-detail tiles. MainActivity removes this when rendering completes or times out. -->
    <TextView
        android:id="@+id/mapStartupCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/rcScreenBg"
        android:gravity="center"
        android:text="Loading map…"
        android:textColor="?attr/rcTextSecondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:maxWidth="210dp"
        android:background="@drawable/panel_background"
        android:elevation="6dp"
        android:text="@string/stats_grouped_initial"
        android:textColor="?attr/rcTextPrimary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="1dp" />

    <TextView
        android:id="@+id/pointsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="68dp"
        android:background="@drawable/points_chip_background"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Garage · ⚔ 0"
        android:contentDescription="Garage and shop. 0 points. Double tap to open."
        android:textColor="?attr/rcTextPrimary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium" />

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="@drawable/circle_button_background"
        android:contentDescription="@string/settings"
        android:elevation="6dp"
        android:padding="12dp"
        android:src="@drawable/ic_settings"
        android:tint="?attr/rcTextPrimary" />

    <ImageButton
        android:id="@+id/centerCarButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="68dp"
        android:background="@drawable/circle_button_background"
        android:contentDescription="@string/center_on_car"
        android:elevation="6dp"
        android:padding="12dp"
        android:src="@drawable/ic_my_location"
        android:tint="?attr/rcTextPrimary" />

    <ImageButton
        android:id="@+id/overlayButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="126dp"
        android:background="@drawable/circle_button_background"
        android:contentDescription="Map layers and overlays"
        android:elevation="6dp"
        android:padding="12dp"
        android:src="@drawable/ic_layers"
        android:tint="?attr/rcTextPrimary" />

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/home_panel_background"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Not tracking"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:accessibilityLiveRegion="polite" />

            <!-- Visible LocationIQ attribution without a separate 48dp-high footer. -->
            <TextView
                android:id="@+id/locationIqCredit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:text="@string/locationiq_credit"
                android:textColorLink="?attr/rcAccent"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/enableButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="6dp"
            android:text="Enable tracking" />

        <LinearLayout
            android:id="@+id/exploreNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tripsNavButton"
                android:drawableTop="@drawable/ic_nav_trips"
                android:drawablePadding="2dp"
                android:drawableTint="?attr/rcTextPrimary"
                android:contentDescription="Trip history and replay"
                style="@style/RoadConquest.NavigationAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_weight="1"
                android:text="Trips" />

            <Button
                android:id="@+id/badgesNavButton"
                android:drawableTop="@drawable/ic_nav_badges"
                android:drawablePadding="2dp"
                android:drawableTint="?attr/rcTextPrimary"
                android:contentDescription="Achievements and milestones"
                style="@style/RoadConquest.NavigationAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Badges" />

            <Button
                android:id="@+id/weeklyGoalsNavButton"
                android:drawableTop="@drawable/ic_nav_weekly"
                android:drawablePadding="2dp"
                android:drawableTint="?attr/rcTextPrimary"
                android:contentDescription="Weekly exploration goals"
                style="@style/RoadConquest.NavigationAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Goals" />
            <Button
                android:id="@+id/forumNavButton"
                style="@style/RoadConquest.NavigationAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minHeight="58dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:drawableTop="@drawable/ic_forum"
                android:drawablePadding="2dp"
                android:drawableTint="?attr/rcTextPrimary"
                android:contentDescription="Public community forum"
                android:text="Forum" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
