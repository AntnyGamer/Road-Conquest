<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:maplibre="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Keep the live map and fog on MapLibre's render surface. -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        maplibre:maplibre_cameraZoomMax="20.0"
        maplibre:maplibre_renderTextureMode="true"
        maplibre:maplibre_pixelRatio="2.0" />

    <TextView
        android:id="@+id/statsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:maxWidth="210dp"
        android:background="@drawable/panel_background"
        android:elevation="6dp"
        android:text="@string/stats_grouped_initial"
        android:textColor="?attr/rcTextPrimary"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="5dp" />

    <TextView
        android:id="@+id/pointsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="102dp"
        android:background="@drawable/points_chip_background"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Garage · ⚔ 0"
        android:textColor="?attr/rcTextPrimary"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/circle_button_background"
        android:contentDescription="@string/settings"
        android:elevation="6dp"
        android:padding="13dp"
        android:src="@drawable/ic_settings"
        android:tint="?attr/rcTextPrimary" />

    <ImageButton
        android:id="@+id/centerCarButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="80dp"
        android:background="@drawable/circle_button_background"
        android:contentDescription="@string/center_on_car"
        android:elevation="6dp"
        android:padding="13dp"
        android:src="@drawable/ic_my_location"
        android:tint="?attr/rcTextPrimary" />

    <ImageButton
        android:id="@+id/overlayButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="144dp"
        android:background="@drawable/circle_button_background"
        android:contentDescription="Map layers and overlays"
        android:elevation="6dp"
        android:padding="13dp"
        android:src="@drawable/ic_layers"
        android:tint="?attr/rcTextPrimary" />

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/home_panel_background"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="YOUR DRIVE"
            android:letterSpacing="0.12"
            android:textColor="?attr/rcTextSecondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Not tracking"
            android:textColor="?attr/rcTextPrimary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:accessibilityLiveRegion="polite" />

        <Button
            android:id="@+id/enableButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="12dp"
            android:text="Enable tracking" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="?attr/rcOutline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tripsNavButton"
                android:drawableTop="@drawable/ic_nav_trips"
                android:drawablePadding="3dp"
                android:drawableTint="?attr/rcTextPrimary"
                android:contentDescription="Trip history and replay"
                style="@style/RoadConquest.NavigationAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_weight="1"
                android:text="Trips" />

            <Button
                android:id="@+id/goalsNavButton"
                android:drawableTop="@drawable/ic_nav_badges"
                android:drawablePadding="3dp"
                android:drawableTint="?attr/rcTextPrimary"
                android:contentDescription="Achievements and milestones"
                style="@style/RoadConquest.NavigationAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Badges" />

            <Button
                android:id="@+id/friendsNavButton"
                android:drawableTop="@drawable/ic_nav_weekly"
                android:drawablePadding="3dp"
                android:drawableTint="?attr/rcTextPrimary"
                android:contentDescription="Weekly exploration goals"
                style="@style/RoadConquest.NavigationAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Goals" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>