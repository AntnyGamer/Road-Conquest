<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/accountRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <Button
            android:id="@+id/backNavButton"
            style="@style/RoadConquest.BackAction"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:text="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Account"
            android:accessibilityHeading="true"
            android:textColor="?attr/rcTextPrimary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/accountStatusText"
            android:accessibilityLiveRegion="polite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="?attr/rcTextSecondary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/accountAuthGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/settings_card_background"
            android:padding="18dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/accountUsername"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:autofillHints="username"
                android:hint="Username"
                android:inputType="text"
                android:maxLength="24"
                android:singleLine="true"
                android:background="@drawable/input_background"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="?attr/rcTextPrimary"
                android:textColorHint="?attr/rcTextSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/accountPassword"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:autofillHints="password"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:maxLength="128"
                    android:saveEnabled="false"
                    android:singleLine="true"
                android:background="@drawable/input_background"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="?attr/rcTextPrimary"
                android:textColorHint="?attr/rcTextSecondary" />

                <ImageButton
                    android:id="@+id/accountPasswordVisibility"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Show password"
                    android:padding="12dp"
                    android:src="@drawable/ic_visibility" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/accountConfirmPassword"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:autofillHints="newPassword"
                    android:hint="Confirm password"
                    android:inputType="textPassword"
                    android:maxLength="128"
                    android:saveEnabled="false"
                    android:singleLine="true"
                android:background="@drawable/input_background"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="?attr/rcTextPrimary"
                android:textColorHint="?attr/rcTextSecondary" />

                <ImageButton
                    android:id="@+id/accountConfirmPasswordVisibility"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Show password"
                    android:padding="12dp"
                    android:src="@drawable/ic_visibility" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Confirm password is only needed when creating an account."
                android:textColor="?attr/rcTextSecondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Username: 3–24 letters, numbers or underscores (case-insensitive). Password: 8–128 characters."
                android:textColor="?attr/rcTextSecondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/accountSignupButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Create account" />

            <Button
                android:id="@+id/accountLoginButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Sign in" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/accountSignedInGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/settings_card_background"
            android:padding="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/accountSignedInText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/accountLeaderboardInfo"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Rankings count verified live exploration only. Imports and local points do not count. Sharing live GPS requires consent."
                android:textColor="?attr/rcTextSecondary"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/accountLeaderboardSwitch"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Show my profile on global leaderboards"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Turn this off to hide your profile without deleting your account."
                android:id="@+id/accountLeaderboardPrivacyHelp"
                android:visibility="gone"
                android:textColor="?attr/rcTextSecondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/accountChangeUsernameButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Change username" />

            <Button
                android:id="@+id/accountLogoutButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Sign out" />

            <Button
                android:id="@+id/accountDeleteButton"
                style="@style/RoadConquest.DangerAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Delete account" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
