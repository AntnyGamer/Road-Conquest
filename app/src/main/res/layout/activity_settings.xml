<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipToPadding="false"
    android:background="?attr/rcScreenBg">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <Button
            android:id="@+id/backNavButton"
            style="@style/RoadConquest.BackAction"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:text="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Settings"
            android:accessibilityHeading="true"
            android:textColor="?attr/rcTextPrimary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/mapSettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/settings_card_background"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Appearance"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/mapStyleButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Map: Streets"
                android:drawableStart="@drawable/ic_map_day"
                android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp" />

            <Button
                android:id="@+id/uiThemeButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Appearance: Use phone setting"
                android:drawableStart="@drawable/ic_appearance"
                android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp" />

            <Switch
                android:id="@+id/fogSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/settings_action_background"
                android:minHeight="52dp"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:text="Show fog"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Fog only changes the map view. Tracking and progress continue."
                android:textColor="?attr/rcTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/trackingSettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/settings_card_background"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tracking"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/manualOnlySwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/settings_action_background"
                android:minHeight="56dp"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:text="Track only when I press Enable"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Precise location and unrestricted battery use improve tracking."
                android:textColor="?attr/rcTextSecondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/locationSettingsButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Location permission"
                android:drawableStart="@drawable/ic_my_location"
                android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp" />

            <Button
                android:id="@+id/deviceLocationButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Device location settings"
                android:drawableStart="@drawable/ic_my_location"
                android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp" />

            <Button
                android:id="@+id/notificationSettingsButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Notification settings"
                android:drawableStart="@drawable/ic_notifications"
                android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp" />

            <Button
                android:id="@+id/batterySettingsButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Battery settings"
                android:drawableStart="@drawable/ic_battery"
                android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/accountSettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/settings_card_background"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Account"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/accountSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Not signed in"
                android:textColor="?attr/rcTextSecondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/accountButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Manage account"
                android:drawableStart="@drawable/ic_account"
                android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp" />
            <Button
                android:id="@+id/communityButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawableStart="@drawable/ic_forum"
                android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp"
                android:text="Community forum" />

            <Switch
                android:id="@+id/leaderboardPrivacySwitch"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/settings_action_background"
                android:enabled="false"
                android:minHeight="56dp"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:text="Show me on global leaderboards"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/verifyDrivesSwitch"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/settings_action_background"
                android:enabled="false"
                android:minHeight="64dp"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:text="Share live GPS to verify explored cells"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/verificationStatusText"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Checking verified scoring…"
                android:textColor="?attr/rcTextSecondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/leaderboardsButton"
                android:visibility="gone"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Global leaderboards"
                android:drawableStart="@drawable/ic_nav_badges"
                android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/progressSettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/settings_card_background"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Progress"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/achievementsButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Achievements"
                android:drawableStart="@drawable/ic_nav_badges"
                android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp" />

            <Button
                android:id="@+id/shopButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Garage &amp; Shop"
                android:drawableStart="@drawable/ic_garage"
                android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp" />

            <Button
                android:id="@+id/tripHistoryButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Trip history"
                android:drawableStart="@drawable/ic_nav_trips"
                android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp" />

            <Button android:id="@+id/challengesButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Weekly goals &amp; friends"
                android:drawableStart="@drawable/ic_nav_weekly"
                android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp" />

            <TextView
                android:id="@+id/dataSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/settings_action_background"
                android:padding="14dp"
                android:textColor="?attr/rcTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/privacySettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/settings_card_background"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data and privacy"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Switch android:id="@+id/friendNotificationsSwitch" style="@style/RoadConquest.PrivacyToggle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/friend_notifications_title" />
            <Switch android:id="@+id/friendForumPostsSwitch" style="@style/RoadConquest.PrivacyToggle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/friend_posts_title" />
            <Switch android:id="@+id/weeklyRemindersSwitch" style="@style/RoadConquest.PrivacyToggle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/weekly_reminders_title" />
            <Switch android:id="@+id/crashReportingSwitch" style="@style/RoadConquest.PrivacyToggle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/crash_reporting_title" />
            <Button
                android:id="@+id/privacyPolicyButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Privacy policy"
                android:drawableStart="@drawable/ic_privacy"
                android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp" />

            <Button
                android:id="@+id/exportButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Export data (.zip)"
                android:drawableStart="@drawable/ic_export"
                android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp" />

            <Button android:id="@+id/importButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Restore progress"
                android:drawableStart="@drawable/ic_restore"
                android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp" />

            <Button
                android:id="@+id/deleteDeviceDataButton"
                style="@style/RoadConquest.DangerAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Delete local data"
                android:drawableStart="@drawable/ic_delete"
                android:drawableTint="@color/danger"
                android:drawablePadding="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Permanently deletes all local progress, including trips, roads, explored places, fog, points and cosmetics bought with points. Your cloud account and Google Play VIP remain. Confirmation is required."
                android:textColor="?attr/rcTextSecondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Saved trips stay on your phone unless exported. Place overlays request boundaries by name. Road matching sends GPS data through Road Conquest’s map service to Geoapify or LocationIQ. Verified scoring sends live GPS and integrity evidence only when enabled."
                android:textColor="?attr/rcTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:orientation="vertical" android:padding="16dp"
            android:background="@drawable/settings_card_background" android:elevation="3dp">
            <Button android:id="@+id/quickTourButton" style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_tour" android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp" android:text="@string/tour_replay" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/tour_replay_detail"
                android:textColor="?attr/rcTextSecondary" android:textSize="13sp" />
            <Switch android:id="@+id/exitConfirmationSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp"
                android:text="@string/exit_confirmation_setting" android:textColor="?attr/rcTextPrimary"
                android:textSize="15sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/exit_confirmation_detail"
                android:textColor="?attr/rcTextSecondary" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aboutSettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/settings_card_background"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="About"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Map and overlay data: OpenStreetMap contributors via OpenFreeMap/OpenMapTiles and Nominatim. Road matching: Geoapify and LocationIQ."
                android:textColor="?attr/rcTextSecondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/appVersionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Version"
                android:textColor="?attr/rcTextSecondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/terrainCreditsButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Licenses and map credits"
                android:drawableStart="@drawable/ic_info"
                android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp" />

            <Button
                android:id="@+id/githubButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/github_button"
                android:drawableStart="@drawable/ic_code"
                android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp" />

            <Button
                android:id="@+id/supportDeveloperButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawableStart="@drawable/ic_coffee"
                android:drawableTint="?attr/rcAccent"
                android:drawablePadding="12dp"
                android:text="@string/support_developer" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/support_developer_description"
                android:textColor="?attr/rcTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
    <include layout="@layout/ad_banner" />
</LinearLayout>
