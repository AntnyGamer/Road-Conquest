<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipToPadding="false">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="?attr/rcTextPrimary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Appearance, tracking, account, progress, data and privacy."
            android:textColor="?attr/rcTextSecondary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/mapSettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/settings_card_background"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Appearance"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Change how Road Conquest looks without affecting saved progress."
                android:textColor="?attr/rcTextSecondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/mapStyleButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Map: Streets" />

            <Button
                android:id="@+id/uiThemeButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Appearance: Use phone setting" />

            <Switch
                android:id="@+id/fogSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/settings_action_background"
                android:minHeight="52dp"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:text="Show fog"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Hiding fog changes only the map view; tracking and saved progress continue normally."
                android:textColor="?attr/rcTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/trackingSettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/settings_card_background"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tracking"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Control automatic tracking and Android permissions."
                android:textColor="?attr/rcTextSecondary"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/manualOnlySwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/settings_action_background"
                android:minHeight="56dp"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:text="Track only when I press Enable"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="When automatic tracking is on, precise location and unrestricted background use give the most reliable results."
                android:textColor="?attr/rcTextSecondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/locationSettingsButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Location permission" />

            <Button
                android:id="@+id/deviceLocationButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Device location settings" />

            <Button
                android:id="@+id/notificationSettingsButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Road Conquest notifications" />

            <Button
                android:id="@+id/batterySettingsButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Battery and background use" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/accountSettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/settings_card_background"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Account"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/accountSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Not signed in"
                android:textColor="?attr/rcTextSecondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/accountButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Manage account" />

            <Switch
                android:id="@+id/leaderboardPrivacySwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/settings_action_background"
                android:enabled="false"
                android:minHeight="56dp"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:text="Show me on global leaderboards"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/verifyDrivesSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/settings_action_background"
                android:enabled="false"
                android:minHeight="64dp"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:text="Send live driving evidence for verified scores"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/verificationStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Checking verified scoring…"
                android:textColor="?attr/rcTextSecondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/leaderboardsButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Global leaderboards" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/progressSettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/settings_card_background"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Progress"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Achievements, cosmetics, points and exploration totals."
                android:textColor="?attr/rcTextSecondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/achievementsButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Achievements" />

            <Button
                android:id="@+id/shopButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Garage and points shop" />

            <Button
                android:id="@+id/tripHistoryButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Trip history and replay" />

            <TextView
                android:id="@+id/dataSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/settings_action_background"
                android:padding="14dp"
                android:textColor="?attr/rcTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/privacySettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/settings_card_background"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data and privacy"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Export your history and review how Road Conquest handles driving data."
                android:textColor="?attr/rcTextSecondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/privacyPolicyButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Privacy policy" />

            <Button
                android:id="@+id/exportButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Export my data (.zip)" />

            <Button
                android:id="@+id/deleteDeviceDataButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Delete all data" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Permanently deletes this phone’s trips, mileage, roads, explored places, points, purchases and cosmetics. Your cloud account and leaderboard scores stay. You must type the exact confirmation phrase shown before deletion."
                android:textColor="?attr/rcTextSecondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Drive history stays on this device unless you export it. Enabling a place overlay sends discovered place names to the configured boundary service and caches returned public boundaries locally. Road matching sends GPS batches to OSRM. Verified scoring sends live GPS and app-integrity evidence only when enabled."
                android:textColor="?attr/rcTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aboutSettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/settings_card_background"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="About"
                android:textColor="?attr/rcTextPrimary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Map and overlay data: OpenStreetMap contributors via OpenFreeMap/OpenMapTiles and Nominatim. Road matching: OSRM."
                android:textColor="?attr/rcTextSecondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/appVersionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Version"
                android:textColor="?attr/rcTextSecondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/terrainCreditsButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Licenses and map credits" />

            <Button
                android:id="@+id/githubButton"
                style="@style/RoadConquest.SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/github_button" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
    <include layout="@layout/ad_banner" />
</LinearLayout>
