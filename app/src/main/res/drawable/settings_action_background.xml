<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="?attr/rcPanelBg" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="?attr/rcOutline" />
        </shape>
    </item>
    <item>
        <ripple android:color="?attr/rcOutline">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/rcMutedBg" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
